  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::Dialogo
  texto: {fileID: 501854383}
  dialogos:
  - "Juancito, un joven de Adrogu\xE9, sale de una fiesta durante la noche y vuelve
    a su casa. El recorrido transcurre con normalidad mientras avanza por las calles
    de la ciudad"
  - "sin embargo, durante el trayecto comienza a percibir situaciones extra\xF1as
    y, al pasar por la Casa de la Cultura, Juancito observa por unos instantes una
    Luz Mala que desaparece casi inmediatamente."
  - "Aunque \xE9l no sabe lo que acaba de ver, contin\xFAa el camino hacia la estacion..."
  caracteresPorSegundo: 30
  salteable: 0
  dialogoFinalizado:
    m_PersistentCalls:
      m_Calls:
      - m_Target: {fileID: 797902816}
        m_TargetAssemblyTypeName: CambiarEscena, Assembly-CSharp
        m_MethodName: CargarEscenaAlFinalizarTransicion
        m_Mode: 1
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: 0
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 1
  debugMode: 1
